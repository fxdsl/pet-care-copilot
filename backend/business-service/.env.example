MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=pet_assistant
MYSQL_USERNAME=root
MYSQL_PASSWORD=change_me
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=pet_assistant
RABBITMQ_PASSWORD=pet_assistant_dev
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=petassistant
MINIO_SECRET_KEY=petassistant_dev_secret
MINIO_BUCKET=pet-community
MINIO_CONNECT_TIMEOUT=2s
MINIO_READ_TIMEOUT=5s

# 第七周认证配置：生产环境务必替换 JWT_SECRET。
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# 可选：首次启动时创建本地管理员。用户名已存在时不会覆盖密码或角色。
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
AI_SERVICE_BASE_URL=http://localhost:8000
# Agent 可能进行多轮模型决策；超时应大于单次百炼请求超时。
AI_SERVICE_RESPONSE_TIMEOUT=35s
FRONTEND_ORIGIN=http://localhost:5173

# 多轮上下文缓存固定为最近 12 条，TTL 在 application.yml 中为 30 分钟。
