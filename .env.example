# 浏览器访问的统一 Gateway 地址；业务服务 8080 不直接暴露给浏览器。
VITE_BUSINESS_API_BASE_URL=http://localhost:8088
GATEWAY_PORT=8088
BUSINESS_SERVICE_URI=http://localhost:8080
GATEWAY_REPLENISH_RATE=20
GATEWAY_BURST_CAPACITY=40

# Spring Boot 调用 FastAPI 的内部地址
AI_SERVICE_BASE_URL=http://localhost:8000
# Java 等待完整 Agent 回答的时间，应覆盖多轮模型决策与工具执行。
AI_SERVICE_RESPONSE_TIMEOUT=35s

# Spring Boot 使用的 MySQL 与 Redis；真实密码只写入本机 .env
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=pet_assistant
MYSQL_USERNAME=root
MYSQL_PASSWORD=change_me
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=pet_assistant
RABBITMQ_PASSWORD=pet_assistant_dev
# 本地暂时不启动 RabbitMQ 时可设为 false；此时知识投稿不会自动完成预检和发布。
KNOWLEDGE_RABBIT_LISTENER_ENABLED=true
SEARCH_RABBIT_LISTENER_ENABLED=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=petassistant
MINIO_SECRET_KEY=petassistant_dev_secret
MINIO_BUCKET=pet-community
MINIO_CONNECT_TIMEOUT=2s
MINIO_READ_TIMEOUT=5s

# 第十二周统一搜索副本；关闭时接口自动使用同权限范围的 MySQL 降级查询。
OPENSEARCH_ENABLED=true
# 默认连接本机 OpenSearch；使用虚拟机时在本机 .env 中覆盖为实际地址。
OPENSEARCH_ENDPOINT=http://localhost:9200
OPENSEARCH_INDEX=pet_assistant_public_v1
OPENSEARCH_CONNECT_TIMEOUT=3s
OPENSEARCH_READ_TIMEOUT=10s
SEARCH_RABBIT_LISTENER_ENABLED=true
SEARCH_RESULT_CACHE_TTL=2m

# 阿里云百炼默认配置；真实 Key 使用系统环境变量 DASHSCOPE_API_KEY。
AI_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_LLM_API_KEY=
AI_LLM_CHAT_MODEL=qwen3.7-plus
AI_LLM_TIMEOUT_SECONDS=20

# LangGraph 循环保护；工具次数越高，可能消耗越多免费模型额度。
AI_AGENT_MAX_TOOL_CALLS=3
AI_AGENT_MAX_CONSECUTIVE_ERRORS=2
AI_AGENT_RECURSION_LIMIT=12
AI_AGENT_MAX_OBSERVATION_CHARS=5000

# 免费本地中文 embedding，不消耗百炼额度。
AI_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AI_EMBEDDING_DIMENSIONS=512
AI_EMBEDDING_CACHE_DIR=.cache/fastembed
