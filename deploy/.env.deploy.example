# 复制为 deploy/.env.deploy 后再修改；该真实文件已由根 .gitignore 的 .env 规则排除。
MYSQL_DATABASE=pet_assistant
MYSQL_USERNAME=pet_app
MYSQL_PASSWORD=replace_with_long_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_different_root_password
REDIS_PASSWORD=replace_with_long_redis_password
RABBITMQ_USERNAME=pet_assistant
RABBITMQ_PASSWORD=replace_with_long_rabbitmq_password
MINIO_ACCESS_KEY=petassistant
MINIO_SECRET_KEY=replace_with_at_least_16_chars
MINIO_BUCKET=pet-community
# 容器内部通过网络别名访问 MinIO；浏览器使用独立的公网地址访问和上传。
MINIO_HOSTNAME=pet-files.local
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
JWT_SECRET=replace_with_at_least_32_random_characters
# 仅首次启动创建管理员；成功登录后请清空并重新创建容器。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_strong_admin_password
FRONTEND_ORIGIN=http://localhost
DASHSCOPE_API_KEY=
AI_LLM_CHAT_MODEL=qwen3.7-plus
GRAFANA_ADMIN_PASSWORD=replace_with_grafana_password
# Gateway 参数不影响默认单体部署，仅供未来启用 microservices profile。
GATEWAY_REPLENISH_RATE=20
GATEWAY_BURST_CAPACITY=40
