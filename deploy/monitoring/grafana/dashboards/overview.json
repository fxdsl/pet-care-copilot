{
  "title": "Pet Care Copilot Overview",
  "uid": "pet-care-overview",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "HTTP QPS", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }, "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (application)", "legendFormat": "{{application}}" }] },
    { "id": 2, "type": "timeseries", "title": "HTTP P95 latency", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }, "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, application))", "legendFormat": "{{application}}" }] },
    { "id": 3, "type": "timeseries", "title": "HTTP 5xx rate", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 }, "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) by (application)", "legendFormat": "{{application}}" }] },
    { "id": 4, "type": "timeseries", "title": "RabbitMQ backlog", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 }, "targets": [{ "expr": "pet_queue_backlog_messages", "legendFormat": "{{queue}}" }] },
    { "id": 5, "type": "timeseries", "title": "Circuit breaker state", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 }, "targets": [{ "expr": "resilience4j_circuitbreaker_state", "legendFormat": "{{name}} {{state}}" }] },
    { "id": 6, "type": "stat", "title": "Agent tool calls", "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 }, "targets": [{ "expr": "sum(increase(pet_agent_tool_calls_total[1h]))" }] },
    { "id": 7, "type": "stat", "title": "Estimated AI tokens", "description": "字符数估算，不是供应商账单 usage", "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 }, "targets": [{ "expr": "sum(increase(pet_ai_estimated_tokens_total[1h]))" }] },
    { "id": 8, "type": "timeseries", "title": "Knowledge review latency", "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 }, "targets": [{ "expr": "rate(pet_knowledge_review_latency_seconds_sum[5m]) / rate(pet_knowledge_review_latency_seconds_count[5m])" }] }
  ]
}
